---
import Icon from "./Icon.astro";

interface Props {
  image: string;
  label: string;
  title: string;
  subtitle: string;
  description: string;
  href: string;
}

const { image, label, title, subtitle, description, href } = Astro.props;
---

<a class="case-card" href={href} target="_blank" rel="noreferrer" aria-label={`View ${title} case study`}>
  <div class="case-card__image">
    <img src={image} alt={`${title} case study preview`} loading="lazy" />
  </div>
  <div class="case-card__body">
    <span class="label-pill">{label}</span>
    <h3>{title}</h3>
    <p class="case-card__subtitle">{subtitle}</p>
    <p class="case-card__description">{description}</p>
    <span class="button button-link button-48 case-card__cta">
      <Icon name="arrow-right" />
      <span>View Case Study</span>
    </span>
  </div>
</a>
