---
import Icon from "./Icon.astro";
import { atWorkSlides } from "../data/site";
---

<div class="at-work-slider" data-at-work-slider>
  <div
    class="at-work-stage"
    aria-label="A Little More Than Work photo carousel"
    aria-live="polite"
    aria-roledescription="carousel"
    tabindex="0"
  >
    {atWorkSlides.map((item, index) => (
      <figure
        class="at-work-card"
        data-at-work-slide={index}
        data-position={index === 0 ? "far-prev" : index === 1 ? "prev" : index === 2 ? "active" : index === 3 ? "next" : index === 4 ? "far-next" : "hidden"}
        aria-hidden={index === 2 ? "false" : "true"}
      >
        {item.image ? (
          <img src={item.image} alt={item.alt} loading="lazy" />
        ) : (
          <div class="at-work-placeholder" aria-hidden="true"></div>
        )}
      </figure>
    ))}
  </div>

  <div class="at-work-controls">
    <button type="button" class="slider-button" data-at-work-prev aria-label="Previous photo">
      <Icon name="arrow-left" />
    </button>
    <span data-at-work-count>03 / 12</span>
    <button type="button" class="slider-button" data-at-work-next aria-label="Next photo">
      <Icon name="chevron-right" />
    </button>
  </div>
</div>

<script>
  const atWorkSlider = document.querySelector("[data-at-work-slider]");
  if (atWorkSlider) {
    const slides = [...atWorkSlider.querySelectorAll("[data-at-work-slide]")];
    const stage = atWorkSlider.querySelector(".at-work-stage");
    const count = atWorkSlider.querySelector("[data-at-work-count]");
    let active = 2;
    let pointerStart = 0;
    let pointerDelta = 0;
    let dragging = false;
    let suppressClick = false;

    const goTo = (index) => {
      active = (index + slides.length) % slides.length;
      update();
    };

    const update = () => {
      slides.forEach((slide, index) => {
        const forwardOffset = (index - active + slides.length) % slides.length;
        const offset = forwardOffset > slides.length / 2 ? forwardOffset - slides.length : forwardOffset;
        const position =
          offset === 0
            ? "active"
            : offset === 1
              ? "next"
              : offset === -1
                ? "prev"
                : offset === 2
                  ? "far-next"
                  : offset === -2
                    ? "far-prev"
                    : "hidden";
        slide.dataset.position = position;
        slide.setAttribute("aria-hidden", position === "active" ? "false" : "true");
      });

      if (count) count.textContent = `${String(active + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
    };

    atWorkSlider.querySelector("[data-at-work-prev]")?.addEventListener("click", () => {
      goTo(active - 1);
    });

    atWorkSlider.querySelector("[data-at-work-next]")?.addEventListener("click", () => {
      goTo(active + 1);
    });

    slides.forEach((slide, index) => {
      slide.addEventListener("click", () => {
        if (suppressClick) return;
        if (slide.dataset.position === "prev") goTo(active - 1);
        if (slide.dataset.position === "next") goTo(active + 1);
      });
    });

    stage?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goTo(active - 1);
      if (event.key === "ArrowRight") goTo(active + 1);
    });

    stage?.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      dragging = true;
      pointerStart = event.clientX;
      pointerDelta = 0;
      stage.setPointerCapture(event.pointerId);
      stage.classList.add("is-dragging");
    });

    stage?.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      pointerDelta = Math.max(-76, Math.min(76, event.clientX - pointerStart));
      stage.style.setProperty("--at-work-drag-x", `${pointerDelta}px`);
    });

    const finishDrag = (event) => {
      if (!dragging) return;
      dragging = false;
      stage.releasePointerCapture?.(event.pointerId);
      stage.classList.remove("is-dragging");
      stage.style.setProperty("--at-work-drag-x", "0px");

      if (Math.abs(pointerDelta) >= 42) {
        suppressClick = true;
        goTo(active + (pointerDelta < 0 ? 1 : -1));
        window.setTimeout(() => {
          suppressClick = false;
        }, 0);
      }
      pointerDelta = 0;
    };

    stage?.addEventListener("pointerup", finishDrag);
    stage?.addEventListener("pointercancel", finishDrag);

    update();
  }
</script>
